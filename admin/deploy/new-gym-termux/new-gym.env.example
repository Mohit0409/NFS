# Copy to ~/.config/new-gym/new-gym.env and chmod 600.
# This profile is intentionally isolated from Gravity Fitness.
GRAVITY_ENV=production
GRAVITY_HOST=127.0.0.1
GRAVITY_PORT=8897
APP_BASE_URL=https://admin.new-gym.example
GRAVITY_RUNTIME_DIR=/data/data/com.termux/files/home/.local/state/new-gym
GRAVITY_DATA_DIR=/data/data/com.termux/files/home/.local/share/new-gym/data
GRAVITY_LOG_DIR=/data/data/com.termux/files/home/.local/state/new-gym/logs
GRAVITY_BACKUP_DIR=/data/data/com.termux/files/home/.local/share/new-gym/backups
# Leave blank to use the checkout-local admin/.venv created by the installer.
GRAVITY_PYTHON=
GRAVITY_LOG_LEVEL=INFO
GRAVITY_TRUST_PROXY=true
GRAVITY_TRUSTED_PROXY_CIDRS=127.0.0.1/32
ADMIN_PORTAL_ROOT_REDIRECT=true

BUSINESS_NAME=New Gym
BUSINESS_TIMEZONE=Asia/Kolkata
BUSINESS_ADDRESS=
BUSINESS_INSTAGRAM=
OWNER_PHONE=
OWNER_WHATSAPP=
OWNER_EMAIL=

SECRET_KEY=
SESSION_IDLE_SECONDS=43200
SESSION_ABSOLUTE_SECONDS=2592000

# New Gym public website + member gateway.
NEW_GYM_PUBLIC_PORT=8899
NEW_GYM_MEMBER_GATEWAY_PORT=8898
NEW_GYM_MEMBER_BACKEND=http://127.0.0.1:8897
NEW_GYM_MEMBER_ALLOWED_ORIGINS=https://www.new-gym.example
NEW_GYM_ADMIN_ROOT=/data/data/com.termux/files/home/new-gym-platform/admin
NEW_GYM_MEMBER_DATABASE=/data/data/com.termux/files/home/.local/share/new-gym/data/gravity.sqlite3

# Use a NEW Firebase project for this gym. Never reuse Gravity's project.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=/data/data/com.termux/files/home/.config/new-gym/firebase-service-account.json

# Optional notifications/providers.
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CUSTOMER_TEMPLATE=
WHATSAPP_OWNER_TEMPLATE=
SMS_PROVIDER=
SMS_API_KEY=
SMS_CUSTOMER_FLOW_ID=
SMS_OWNER_FLOW_ID=
SMS_SENDER_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Stable named Cloudflare Tunnel. Token file must be chmod 600.
CLOUDFLARED_TOKEN_FILE=/data/data/com.termux/files/home/.config/new-gym/cloudflared-token

# Dedicated off-device destination for this gym only.
NEW_GYM_BACKUP_REMOTE=
NEW_GYM_REQUIRE_OFFDEVICE_BACKUP=true
NEW_GYM_OFFDEVICE_BACKUP_MARKER=/data/data/com.termux/files/home/.local/state/new-gym/offdevice-backup.json
NEW_GYM_BACKUP_MAX_AGE_SECONDS=86400

# Owner-reviewed launch gates. Keep false until the real values/data are verified.
NEW_GYM_MEMBERSHIP_PRICING_CONFIRMED=false
NEW_GYM_POOL_RATES_CONFIRMED=false
NEW_GYM_KITCHEN_SETUP_CONFIRMED=false
